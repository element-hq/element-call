{
  "readKey": "a7580769542256117579-70975387172511848f4c6533943d776547bad4853931ba352ee684b738f4494e",

  "upload": {
    "type": "json",
    "deprecate": "file",
    "features": ["plural_postfix_us", "filter_untranslated"],
    "files": [
      {
        "pattern": "locales/en/app.json",
        "lang": "inherited"
      },
      {
        "group": "existing",
        "pattern": "locales/*/app.json",
        "excludes": ["locales/en/app.json"],
        "lang": "${autodetectLang}"
      }
    ]
  },

  "download": {
    "files": [
      {
        "conditions": ["equals: ${file}, app.json"],
        "output": "locales/${langLsrDash}/${file}"
      }
    ],
    "includeSourceLang": "${includeSourceLang|false}"
  }
}
